# ==============================================================================
# AgentGuard Enterprise Security & Governance Platform Configuration
# ==============================================================================

# Application Meta
APP_NAME="AgentGuard – AI Agent Security & Governance Platform"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT="production"

# Server Bindings
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Database Configuration (SQLite default; PostgreSQL ready)
DATABASE_URL="sqlite:///./agentguard.db"

# Security & Governance Thresholds
REFUND_APPROVAL_THRESHOLD=100.0
PAYMENT_APPROVAL_THRESHOLD=500.0
MAX_TRANSACTION_LIMIT=1000000.0

# Platform Policy Engine
DEFAULT_POLICY_MODE="ENFORCE" # ENFORCE | MONITOR_ONLY
DEFAULT_DENY_FALLBACK=true

# Cryptographic Audit Settings
AUDIT_HASH_ALGORITHM="SHA-256"
ENABLE_AUDIT_LOG_TAMPER_PROTECTION=true

# Optional External AI Provider (Mock Agent runs 100% offline without these)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
